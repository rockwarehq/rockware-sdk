[
  {
    "name": "paging follows endCursor until there is no next page",
    "operation": "ListProducts",
    "paginate": true,
    "variables": { "first": 2, "updatedSince": "2026-11-01T00:00:00.000Z" },
    "responses": [
      { "status": 200, "body": { "data": { "products": { "nodes": [{ "id": "p1" }, { "id": "p2" }], "pageInfo": { "hasNextPage": true, "endCursor": "c2" } } } } },
      { "status": 200, "body": { "data": { "products": { "nodes": [{ "id": "p3" }, { "id": "p4" }], "pageInfo": { "hasNextPage": true, "endCursor": "c4" } } } } },
      { "status": 200, "body": { "data": { "products": { "nodes": [{ "id": "p5" }], "pageInfo": { "hasNextPage": false, "endCursor": "c5" } } } } }
    ],
    "assertions": [
      { "type": "requestCount", "expected": 3 },
      { "type": "result", "path": "length", "expected": 5 },
      { "type": "result", "path": "0.id", "expected": "p1" },
      { "type": "result", "path": "4.id", "expected": "p5" },
      { "type": "requestBody", "index": 0, "path": "variables.after", "absent": true },
      { "type": "requestBody", "index": 1, "path": "variables.after", "expected": "c2" },
      { "type": "requestBody", "index": 2, "path": "variables.after", "expected": "c4" },
      { "type": "requestBody", "index": 2, "path": "variables.first", "expected": 2 },
      { "type": "requestBody", "index": 2, "path": "variables.updatedSince", "expectedInstant": "2026-11-01T00:00:00.000Z" }
    ]
  },
  {
    "name": "an empty first page ends paging",
    "operation": "ListOrders",
    "paginate": true,
    "responses": [
      { "status": 200, "body": { "data": { "orders": { "nodes": [], "pageInfo": { "hasNextPage": false, "endCursor": null } } } } }
    ],
    "assertions": [
      { "type": "requestCount", "expected": 1 },
      { "type": "result", "path": "length", "expected": 0 }
    ]
  },
  {
    "name": "paging stops at maxPages",
    "operation": "ListStations",
    "paginate": true,
    "maxPages": 2,
    "responses": [
      { "status": 200, "body": { "data": { "stations": { "nodes": [{ "id": "s1" }], "pageInfo": { "hasNextPage": true, "endCursor": "c1" } } } } },
      { "status": 200, "body": { "data": { "stations": { "nodes": [{ "id": "s2" }], "pageInfo": { "hasNextPage": true, "endCursor": "c2" } } } } }
    ],
    "assertions": [
      { "type": "requestCount", "expected": 2 },
      { "type": "result", "path": "length", "expected": 2 }
    ]
  },
  {
    "name": "paging keeps the required arguments on every page",
    "operation": "ListEntityRecords",
    "paginate": true,
    "variables": { "model": "moldBase" },
    "responses": [
      { "status": 200, "body": { "data": { "entityRecords": { "nodes": [{ "id": "r1" }], "pageInfo": { "hasNextPage": true, "endCursor": "c1" } } } } },
      { "status": 200, "body": { "data": { "entityRecords": { "nodes": [{ "id": "r2" }], "pageInfo": { "hasNextPage": false, "endCursor": "c2" } } } } }
    ],
    "assertions": [
      { "type": "requestBody", "index": 1, "path": "variables.model", "expected": "moldBase" },
      { "type": "result", "path": "length", "expected": 2 }
    ]
  },
  {
    "name": "an error on a later page is thrown, after the records before it",
    "operation": "ListProducts",
    "paginate": true,
    "responses": [
      { "status": 200, "body": { "data": { "products": { "nodes": [{ "id": "p1" }], "pageInfo": { "hasNextPage": true, "endCursor": "c1" } } } } },
      { "status": 403, "body": { "errors": [{ "message": "This token needs the data:read scope" }] } }
    ],
    "assertions": [
      { "type": "requestCount", "expected": 2 },
      { "type": "error", "code": "forbidden" },
      { "type": "result", "path": "length", "expected": 1 }
    ]
  }
]
